# Copy to .env and fill in before `docker compose up -d`.
# Compose reads this file automatically; it is also the file Dokploy's
# Environment tab stands in for.

# Public base URL of this install -- the origin the admin UI is reached at.
# Tracking pixels, click-through links and the unsubscribe page in every
# outgoing email are built from it, so it must be the address recipients can
# actually reach (https://, in production).
APP_URL=https://mail.example.com

# Generate each of these separately: openssl rand -hex 32
# The app refuses to start in production if they are unset or left at the
# development defaults.
JWT_SECRET=
TRACKING_SECRET=

# Postgres credentials for the bundled database container. Keep the password
# URL-safe (a hex string from `openssl rand -hex 24` is ideal) -- it is
# interpolated into DATABASE_URL.
POSTGRES_PASSWORD=
# POSTGRES_USER=dripline
# POSTGRES_DB=dripline

# Which published image to run. Pin DRIPLINE_VERSION to a release tag (e.g.
# 1.2.3) rather than latest if you want upgrades to be deliberate.
# DRIPLINE_IMAGE=ghcr.io/mh-rafi/dripline
# DRIPLINE_VERSION=latest

# Where docker-compose.yml publishes the app. The default keeps it off the
# public internet, for use behind a reverse proxy on the same host. Set
# BIND_ADDRESS=0.0.0.0 only if you are deliberately exposing it directly.
# BIND_ADDRESS=127.0.0.1
# HTTP_PORT=3000

# Domain for the bundled Caddy in docker-compose.caddy.yml (no scheme).
# APP_DOMAIN=mail.example.com

# Trust X-Forwarded-* headers. Correct behind any reverse proxy, which is the
# default deployment; set to false only when the app is exposed directly.
# TRUST_PROXY=true

# Set to false to skip the automatic migration run at container start and
# manage schema changes yourself.
# RUN_MIGRATIONS=true

# Where this instance's source can be obtained. The admin UI links to it. If
# you run a MODIFIED Dripline as a service, AGPL-3.0 section 13 requires this
# to point at your own published source, not upstream.
# SOURCE_URL=https://github.com/mh-rafi/Dripline
