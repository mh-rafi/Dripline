{
  "name": "dripline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Open-source self-hosted email campaigns, drip automation, and multi-provider sending.",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace apps/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "migrate": "npm run migrate --workspace apps/api",
    "import:listmonk": "node scripts/import-from-listmonk.mjs"
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
