{
  "name": "dripline",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "description": "Open-source self-hosted email campaigns, drip automation, and multi-provider sending.",
  "license": "AGPL-3.0-or-later",
  "author": "Mahmudul Hasan",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace apps/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "migrate": "npm run migrate --workspace apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
