PORT=3000
DATABASE_URL=postgres://dripline:dripline@localhost:5432/dripline

# Required in production -- long random values. Insecure defaults are used
# if unset, which is fine for local development only.
JWT_SECRET=
TRACKING_SECRET=

# Public base URL, used to build tracking/unsubscribe links embedded in emails.
# The unsubscribe page is served by the web app, not the API, so in dev this
# must point at the Vite dev server (which proxies /api to this API) rather
# than the API's own port.
APP_URL=http://localhost:5173
