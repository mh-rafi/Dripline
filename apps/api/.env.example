# Local development only. For a real install see docs/self-hosting.md and the
# .env.example in the repository root (which Docker Compose reads).

PORT=3000
DATABASE_URL=postgres://dripline:dripline@localhost:5432/dripline

# Insecure defaults are used if these are unset, which is fine here -- but the
# app refuses to start with NODE_ENV=production unless both are set to unique
# random values (openssl rand -hex 32).
JWT_SECRET=
TRACKING_SECRET=

# Public base URL, used to build tracking/unsubscribe links embedded in emails.
# In development that is the Vite dev server, which serves the unsubscribe page
# and proxies /api to this API. In production one process serves both, so it is
# simply the install's own URL.
APP_URL=http://localhost:5173

# Path to a built admin UI. Auto-detected at apps/web/dist when present, so
# this only needs setting if you moved it. Unset and absent means API-only,
# which is the normal development setup (Vite serves the UI on :5173).
# WEB_DIST=

# Trust X-Forwarded-* headers: true behind a reverse proxy, a hop count, or a
# comma-separated list of trusted CIDRs.
# TRUST_PROXY=false

# Max request body in MB. CSV imports post one JSON array of subscribers.
# BODY_LIMIT_MB=8

# Where this instance's source can be obtained, linked from the admin UI. A
# modified deployment must point this at its own source (AGPL-3.0 section 13).
# SOURCE_URL=https://github.com/mh-rafi/Dripline
